# Copy this file to .env. Never commit a real key.
POLZA_API_KEY=
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_TIMEOUT_SECONDS=75
POLZA_CONNECT_TIMEOUT_SECONDS=10
# Default completion cap for Gemini through Polza. Increase only for a targeted
# retry when an otherwise valid response was cut off before its JSON closes.
POLZA_MAX_COMPLETION_TOKENS=4000

# Direct GigaChat API. Authorization key is exchanged for a short-lived access token.
GIGACHAT_AUTHORIZATION_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
GIGACHAT_BASE_URL=https://api.giga.chat/v1
# Optional custom CA PEM. When omitted, the adapter installs a hash-pinned official
# Минцифры root certificate into .nirs-certs/ on its first direct GigaChat request.
GIGACHAT_CA_BUNDLE=

