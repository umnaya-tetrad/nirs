  "steps": [
    {
      "step_id": "s1",
      "latex": "\\int_{-1}^2 |x^3-x|dx = \\int_{-1}^0 (x^3-x)dx + \\int_0^1 -(x^3-x)dx + \\int_1^2 (x^3-x)dx",
      "derives_from": [],
      "kind": "initial"
    },
    {
      "step_id": "s2",
      "latex": "= \\int_{-1}^0 (x^3-x)dx + \\int_0^1 (x-x^3)dx + \\int_1^2 (x^3-x)dx",
      "derives_from": [
        "s1"
      ],
      "kind": "step"
    },
    {
      "step_id": "s3",
      "latex": "= \\left[\\frac{x^4}{4}-\\frac{x^2}{2}\\right]_{-1}^0 + \\left[\\frac{x^2}{2}-\\frac{x^4}{4}\\right]_0^1 + \\left[\\frac{x^4}{4}-\\frac{x^2}{2}\\right]_1^2",
      "derives_from": [
        "s2"
      ],
      "kind": "step"
    },
    {
      "step_id": "s4",
      "latex": "= \\left(\\frac{0-\\frac{1}{2}}{0}\\right) + \\left(\\frac{1}{2}-\\frac{1}{4}\\right) + \\left(\\frac{4-2}{4}-\\left(\\frac{1}{4}-\\frac{1}{2}\\right)\\right)",
      "derives_from": [
        "s3"
      ],
      "kind": "step"
    },
    {
      "step_id": "s5",
      "latex": "= \\left(0-\\left(\\frac{1}{4}+\\frac{1}{2}\\right)\\right) + \\left(\\frac{1}{2}-\\frac{1}{4}\\right) + \\left(\\frac{4-2}{4}-\\left(\\frac{1}{4}-\\frac{1}{2}\\right)\\right)",
      "derives_from": [
        "s4"
      ],
      "kind": "step"
    },
    {
      "step_id": "s6",
      "latex": "= 0 + \\frac{1}{4} + \\left(\\frac{1}{2}-\\frac{1}{4}\\right)",
      "derives_from": [
        "s5"
      ],
      "kind": "step"
    },
    {
      "step_id": "s7",
      "latex": "= 0 + \\frac{1}{4} + \\frac{1}{4} = \\frac{3}{4}",
      "derives_from": [
        "s6"
      ],
      "kind": "step"
    },
    {
      "step_id": "s8",
      "latex": "= \\frac{1}{4} + \\frac{1}{2} + \\frac{1}{4} = \\frac{3}{2} - \\frac{3}{4} + 2 = \\frac{11}{4}",
      "derives_from": [
        "s5"
      ],
      "kind": "step"
    }
  ],
