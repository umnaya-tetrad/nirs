  "steps": [
    {
      "step_id": "s1",
      "latex": "Comparing the given polynomial with ax^3+bx^2+cx+d,\\text{we get a}=3,b=-5,c=-11,d=-3.",
      "derives_from": [],
      "kind": "initial"
    },
    {
      "step_id": "s2",
      "latex": "Further,\np(3)=3⋅3^3-(5⋅3^2)-(11⋅3)-3=81-45-33-3=0,",
      "derives_from": [
        "s1"
      ],
      "kind": "step"
    },
    {
      "step_id": "s3",
      "latex": "p(-1)=3⋅(-1)^3-5⋅(-1)^2-11⋅(-1)-3=-3-5+11-3=0,",
      "derives_from": [
        "s1"
      ],
      "kind": "step"
    },
    {
      "step_id": "s4",
      "latex": "p(-\\frac{1}{3})=3⋅(-\\frac{1}{3})^3-5⋅(-\\frac{1}{3})^2-11⋅(-\\frac{1}{3})-3=\n=3⋅(-\\frac{1}{27})-5⋅(\\frac{1}{9})+\\frac{11}{3}-3=-\\frac{1}{9}-\\frac{5}{9}+\\frac{11}{3}-3=0.",
      "derives_from": [
        "s1"
      ],
      "kind": "step"
    },
    {
      "step_id": "s5",
      "latex": "Therefore, 3,-1,-\\frac{1}{3} \\text{are the zeros of } 3x^3-5x^2-11x-3.\nSo we take α=3 β=-1 and r=-\\frac{1}{3}.",
      "derives_from": [
        "s2",
        "s3",
        "s4"
      ],
      "kind": "step"
    },
    {
      "step_id": "s6",
      "latex": "α+β+r=3+(-1)+(-\\frac{1}{3})=\\frac{2}{3}=-\\frac{a}{b},",
      "derives_from": [
        "s5"
      ],
      "kind": "step"
    },
    {
      "step_id": "s7",
      "latex": "αβ+βr+ra=3⋅(-1)+(-1)⋅(-\\frac{1}{3})+(-1)⋅3=-3+\\frac{1}{3}-1=-\\frac{11}{3}=\\frac{c}{a},",
      "derives_from": [
        "s5"
      ],
      "kind": "step"
    },
    {
      "step_id": "s8",
      "latex": "αβr=3⋅(-1)⋅(-\\frac{1}{3})=1=-\\frac{d}{a}.",
      "derives_from": [
        "s5"
      ],
      "kind": "step"
    }
  ],
