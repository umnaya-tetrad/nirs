      "step_id": "s1",
      "latex": "\\lim_{x \\to 1} \\frac{x^{15}-1}{x^{10}-1}",
      "derives_from": [],
      "kind": "initial"
    },
    {
      "step_id": "s2",
      "latex": "\\lim_{x \\to 1} \\frac{x^{15}-1}{x^{10}-1} = \\lim_{x \\to 1} \\left(\\frac{x^{15}-1}{x-1}\\cdot \\frac{1}{x^{10}-1} \\right)",
      "derives_from": [
        "s1"
      ],
      "kind": "step"
    },
    {
      "step_id": "s3",
      "latex": "= \\frac{15}{(1)^{14}}{9 (1)^9} = \\frac{15}{9} = \\frac{5}{3}.",
      "derives_from": [
        "s2"
      ],
      "kind": "step"
    },
    {
      "step_id": "s4",
      "latex": "\\lim_{x \\to 0} \\frac{\\sqrt{1+x}-1}{x}",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s5",
      "latex": "Put y = 1 + x, so that y \\rightarrow 1 as x \\rightarrow 0. Then",
      "derives_from": [
        "s4"
      ],
      "kind": "step"
    },
    {
      "step_id": "s6",
      "latex": "\\lim_{x \\to 0} \\frac{\\sqrt{1+x}-1}{x} = \\lim_{y \\to 1} \\frac{\\sqrt{y}-1}{y-1}",
      "derives_from": [
        "s4",
        "s5"
      ],
      "kind": "step"
    },
    {
      "step_id": "s7",
      "latex": "= \\lim_{y \\to 1} \\frac{1/2 y^{-1/2}}{1} = \\frac{1}{2}(1)^{-1/2} = \\frac{1}{2}.",
      "derives_from": [
        "s6"
      ],
      "kind": "step"
    }
  ],
