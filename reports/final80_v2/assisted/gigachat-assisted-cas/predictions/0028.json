      "step_id": "s1",
      "latex": "\\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}\\frac{d x}{\\sqrt{1+\\tan x}}.",
      "derives_from": [],
      "kind": "initial"
    },
    {
      "step_id": "s2",
      "latex": "Let I = \\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}\\frac{d x}{\\sqrt{1 + \\tan x}}.",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s3",
      "latex": "Then, by P₃:",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s4",
      "latex": "I = \\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}\\frac{cos x dx}{\\sqrt{cos x}+\\sqrt{sin x}}. ---(①)",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s5",
      "latex": "We have :",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s6",
      "latex": "I = \\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}\\frac{cos(\\frac{\\pi}{3}+\\frac{\\pi}{6}-x)}{\\sqrt{cos(\\frac{\\pi}{3}+\\frac{\\pi}{6}-x)+\\sqrt{sin(\\frac{\\pi}{3}+\\frac{\\pi}{6}-x)}}dx.",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s7",
      "latex": "= \\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}\\frac{\\sqrt{sin x}}{\\sqrt{sin x}+\\sqrt{cos x}}dx. ---(②)",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s8",
      "latex": "(①)(②) We get :",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s9",
      "latex": "Adding (①) and (②);",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s10",
      "latex": "2I = \\int_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}dx=[x]_{\\frac{\\pi}{6}}^{\\frac{\\pi}{3}}=\\frac{\\pi}{3}-\\frac{\\pi}{6}=\\frac{\\pi}{6}.",
      "derives_from": [],
      "kind": "step"
    },
    {
      "step_id": "s11",
      "latex": "Hence , I = \\frac{\\pi}{12}.",
      "derives_from": [],
      "kind": "step"
    }
  ],
